# Aaroha LMS - React SPA URL Rewriting for Hostinger LiteSpeed / Apache
# Target Domain: lms.aaroha-inc.com

DirectoryIndex index.html index.php
Options -Indexes
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Block direct HTTP access to hidden files and version control directories
  RewriteRule (^\.|\/\.) - [F,L]

  # 2. Route all API requests directly to backend entrypoint (api/index.php) unconditionally
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # 3. Serve physical static files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Route client-side navigation requests to SPA index.html (EXCLUDING /api/)
  RewriteCond %{REQUEST_URI} !^/api(/.*)?$ [NC]
  RewriteRule ^ index.html [L]
</IfModule>

# Security Headers & Cache-Busting Control
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Prevent CDN / proxy caching of SPA entrypoint and API responses
  <FilesMatch "^(index\.html|version\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache static assets with unique build hashes for maximum performance
  <FilesMatch "\.(js|css|webp|png|jpg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
