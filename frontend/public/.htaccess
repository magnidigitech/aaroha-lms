# Aaroha LMS - React SPA URL Rewriting for Hostinger LiteSpeed / Apache
# Target Domain: lms.aaroha-inc.com (public_html/lms/)

Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Block direct HTTP access to hidden files and version control directories
  RewriteRule (^\.|\/\.) - [F,L]

  # 2. Route all API requests directly to backend entrypoint (api/index.php)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]
  RewriteRule ^api$ api/index.php [QSA,L]

  # 3. Serve physical static files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route all other client-side navigation requests to SPA index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Security Headers & Cache-Busting Control
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Prevent CDN / proxy caching of SPA entrypoint and API responses
  <FilesMatch "^(index\.html|version\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache static assets with unique build hashes for maximum performance
  <FilesMatch "\.(js|css|webp|png|jpg|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

